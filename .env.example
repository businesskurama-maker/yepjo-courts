# Copy to .env.local for local development, and add the same two variables in
# Vercel → Project → Settings → Environment Variables.
# Both values are safe to expose in the browser (access is controlled by RLS).
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# NEVER put the service_role key or the Google client secret in this file or in
# Vercel. The service_role key is only used inside the Supabase Edge Function,
# where Supabase provides it automatically. The Google secret is pasted into the
# Supabase dashboard (Authentication → Providers → Google).
